{
  "manifest_version": 3,
  "name": "Adopt.ai Workflow Onboarding Agent",
  "version": "0.3.2",
  "description": "Record enriched browser sessions for API specification elicitation",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "webNavigation",
    "sidePanel",
    "scripting",
    "webRequest",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer/viewer.html", "viewer/viewer.js", "lib/marked.esm.mjs"],
      "matches": ["<all_urls>"],
      "extension_pages": ["*"]
    }
  ]
}
