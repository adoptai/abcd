# ============================================================================
# AdoptAI Tool Builder - Environment Configuration Template
# ============================================================================
# 
# This is a template file for environment variables needed by the Tool Builder.
# Copy this file to .env and fill in your actual values.
#
# IMPORTANT: Never commit .env files with real credentials to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# ADOPT_CLIENT_ID (Required)
# ----------------------------------------------------------------------------
# Your AdoptAI client ID for API authentication.
# 
# This is used to authenticate with the AdoptAI API and obtain a bearer token.
# You can obtain this from your AdoptAI dashboard or by contacting your
# AdoptAI administrator.
#
# Example: ADOPT_CLIENT_ID=abc123def456ghi789
# ----------------------------------------------------------------------------
ADOPT_CLIENT_ID=your_client_id_here


# ----------------------------------------------------------------------------
# ADOPT_CLIENT_SECRET (Required)
# ----------------------------------------------------------------------------
# Your AdoptAI client secret for API authentication.
#
# This secret is paired with your ADOPT_CLIENT_ID to authenticate with the
# AdoptAI API. Keep this value secure and never share it publicly.
#
# Example: ADOPT_CLIENT_SECRET=secret_abc123def456ghi789jkl012
# ----------------------------------------------------------------------------
ADOPT_CLIENT_SECRET=your_client_secret_here


# ----------------------------------------------------------------------------
# ADOPT_API_ENDPOINT (Optional)
# ----------------------------------------------------------------------------
# The base URL for the AdoptAI API endpoint.
#
# Default: https://connect.adopt.ai
#
# If you're using a self-hosted or on-premise AdoptAI instance, change this
# to your custom API endpoint URL. For most users, the default value is correct.
#
# Examples:
#   - Production: https://connect.adopt.ai
#   - Self-hosted: https://adopt.yourcompany.com
#   - Local development: http://localhost:8000
# ----------------------------------------------------------------------------
ADOPT_API_ENDPOINT=https://connect.adopt.ai


# ----------------------------------------------------------------------------
# ADOPT_ACTIONS_ENDPOINT (Optional)
# ----------------------------------------------------------------------------
# The base URL for the AdoptAI Actions API endpoint (for checkout functionality).
#
# Default: https://api.adopt.ai
#
# This endpoint is used to fetch current tool/action details when checking out
# tools to your local agent. Uses the /{action_id}/current/ endpoint.
#
# Examples:
#   - Production: https://api.adopt.ai
#   - Self-hosted: https://api.yourcompany.com
#   - Local development: http://localhost:8001
# ----------------------------------------------------------------------------
ADOPT_ACTIONS_ENDPOINT=https://api.adopt.ai


# ----------------------------------------------------------------------------
# OPENAI_API_KEY (Optional but recommended)
# ----------------------------------------------------------------------------
# Your OpenAI API key for LLM-powered description generation.
#
# This is used to automatically generate tool descriptions based on API details.
# If not provided, you'll need to manually write tool descriptions.
#
# Get your API key from: https://platform.openai.com/api-keys
#
# Example: OPENAI_API_KEY=sk-proj-abc123def456ghi789
# ----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here


# ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY (Optional but recommended)
# ----------------------------------------------------------------------------
# Your Anthropic API key for Claude-powered WDL generation.
#
# This is used to automatically generate Workflow Definition Language (WDL)
# for draft tools using Claude Sonnet 4.5. If not provided, WDL generation
# for draft tools will be skipped.
#
# Get your API key from: https://console.anthropic.com/
#
# Example: ANTHROPIC_API_KEY=sk-ant-api03-abc123def456ghi789
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ============================================================================
# Bulk Evaluation Configuration (AdoptXchange Integration)
# ============================================================================
# These settings enable bulk workflow evaluation using the Maxim platform.
# See: https://docs.getmaxim.ai/

# ----------------------------------------------------------------------------
# MAXIM_API_KEY (Required for bulk evaluations)
# ----------------------------------------------------------------------------
# Your Maxim API key for the evaluation platform.
#
# Get your API key from: https://app.getmaxim.ai/settings/api-keys
#
# Example: MAXIM_API_KEY=mx-abc123def456
# ----------------------------------------------------------------------------
MAXIM_API_KEY=your_maxim_api_key_here


# ----------------------------------------------------------------------------
# MAXIM_WORKSPACE_ID (Required for bulk evaluations)
# ----------------------------------------------------------------------------
# Your Maxim workspace ID where evaluation results will be stored.
#
# Find this in your Maxim workspace URL: https://app.getmaxim.ai/workspace/{id}
#
# Example: MAXIM_WORKSPACE_ID=ws_abc123def456
# ----------------------------------------------------------------------------
MAXIM_WORKSPACE_ID=your_maxim_workspace_id_here


# ----------------------------------------------------------------------------
# AWS Configuration (Required for Bedrock-based evaluations)
# ----------------------------------------------------------------------------
# These are required if you use AWS Bedrock models for agent orchestration.
#
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# BEDROCK_MODEL=us.anthropic.claude-4-sonnet-20250514-v1:0
# ----------------------------------------------------------------------------


# ============================================================================
# Setup Instructions
# ============================================================================
#
# 1. Copy this file to create your .env file:
#    cp dev.env .env
#    OR
#    cp .env.example .env
#
# 2. Edit .env and replace the placeholder values with your actual credentials
#
# 3. Load the environment variables:
#    - Bash/Zsh: export $(cat .env | xargs)
#    - Or: source .env (if using bash-compatible syntax)
#    - Or use a tool like python-dotenv to load automatically
#
# 4. Verify your setup by running:
#    tool-builder
#
# ============================================================================
# Troubleshooting
# ============================================================================
#
# If you see authentication errors:
# - Double-check that ADOPT_CLIENT_ID and ADOPT_CLIENT_SECRET are correct
# - Verify that the ADOPT_API_ENDPOINT is reachable
# - Ensure you have the necessary permissions in your AdoptAI instance
# - Check that environment variables are properly loaded in your shell
#
# ============================================================================

